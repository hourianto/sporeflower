package pkg;

import java.util.Arrays;

public class TestJADNaming {
   public void Func() {
      int i = 1000;// 5
      int j = 2000;
      int k = 3000;
      int l = 4000;
      if (i != j && k == l) {// 6
      }

      boolean flag = true;// 7
      boolean flag1 = false;
      boolean flag2 = true;
      boolean flag3 = false;
      if (flag != flag1 && flag2 == flag3) {// 8
      }
   }// 9

   public void types() {
      short short1 = 0;// 12
      short short2 = 0;// 13
      byte b0 = 0;// 14
      byte b1 = 0;// 15
      char c0 = 'c';// 16
      char c1 = 'c';// 17
      double d0 = 0.5;// 18
      double d1 = 0.5;// 19
      float f = 0.5F;// 20
      float f1 = 0.5F;// 21
      int i = 1;// 23
      int j = 1;// 24
      long k = 1L;// 25
      long l = 1L;// 26
      int i1 = 1;// 27
      int j1 = 1;// 28
      long k1 = 1L;// 29
   }// 30

   public void objects() {
      Class oclass = null;// 33
      Class oclass1 = null;// 34
      Enum oenum = null;// 36
      Enum oenum1 = null;// 37
      Package opackage = null;// 39
      Package opackage1 = null;// 40
      System.out.println(Arrays.asList(oclass, oclass1, oenum, oenum1, opackage, opackage1));// 41
   }// 42
}

