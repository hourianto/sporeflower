  invokevirtual Method java/lang/String.length:"()I";
  ireturn;
Lend:
  stack_frame_type full;
  locals_map int, null;
  iconst_3;
  ireturn;
}

// No load coincides with a frame; metadata must reach the null definition.
public static Method delayedArray:"(I)Z"
