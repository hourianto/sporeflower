// A frame describes the old value in slot 1, not the astore at its offset.
public static Method overwrite:"(Z)I"
  stack 2 locals 2
{
  iconst_1;
  newarray boolean;
  astore_1;
  aconst_null;
  goto Lstore;
Lstore:
  stack_frame_type full;
  locals_map int, class "[Z";
  stack_map null;
  astore_1;
  iload_0;
