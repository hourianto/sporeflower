package pkg;

public class TestOperatorPrecedence {
   static void test() {
      Integer a = 3;// 6
      System.out.println((a = a + 1) + Integer.valueOf(a + 1));// 7
   }// 8

   static void test2() {
      Integer a = 3;// 11
      System.out.println((a = a + 1) + (a = a + 1));// 12
      System.out.println(a);// 13
   }// 14

   static void test3() {
      Integer a = 3;// 17
      System.out.println((a = a + 1) + (a = a + 1) + Integer.valueOf(a + 1));// 18
   }// 19

   static void testNoBox() {
      int a = 3;// 22
      System.out.println(++a + ++a);// 23
   }// 24
}

