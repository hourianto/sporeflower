public class TestForCyclicVarDef {
   public void test() {
      short var2 = 12338;// 5
      if (var2 == -8396) {
         return;// 6
      }

      float var9 = 22.22F;// 9

      while (var9 > 133.07F) {
         var9 -= -15.01F;// 10
         System.out.println("Hi");// 11
         var9 *= 29.43F;
      }
   }// 13

