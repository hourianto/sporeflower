package pkg;

public class TestLoopFinally {
   public void test() {
      for (int i = 0; i < 10; i++) {// 5
         try {
            System.out.println(i);// 7
         } finally {
            System.out.println("finally");// 9
            if (i == 5) {// 11
               break;
            }

            System.out.println("finally2");// 15
         }
      }

      System.out.println("after");// 19
   }// 20

   public void test1() {
      for (int i = 0; i < 10; i++) {// 23
         try {
            System.out.println(i);// 25
         } finally {
            System.out.println("finally");// 27
            if (i != 5) {// 29
               if (i == 4) {// 32
                  System.out.println("break");// 33
                  break;// 34
               }

               System.out.println("finally2");// 37
            }

            System.out.println("continue");// 30
            continue;// 31
         }
      }

      System.out.println("after");// 41
   }// 42

   public void test2() {
      for (int i = 0; i < 10; i++) {// 45
         try {
            System.out.println(i);// 47
         } finally {
            System.out.println("finally");// 49
            if (i != 5) {// 51
               continue;
            }
            break;
         }
      }

      System.out.println("after");// 59
   }// 60

   public int test3(int x) {
      do {
         try {
            if (x == 1) {// 66
               return 1;// 67
            }

            System.out.println("Oops");// 70
            if (x == 23) {// 71
               return 1;// 72
            }

            System.out.println("Oops");// 75
            if (x == 25) {// 76
               return 1;// 77
            }
         } finally {
            if (x == 3) {// 80
               break;
            }
         }
      } while (x < 45);// 84

      System.out.print(5);// 86
      return 1;// 87
   }

   public int test4(int x) {
      do {
         try {
            if (x < 25) {// 94
               return 5;// 95
            }
         } finally {
            if (x > 3) {// 98
               break;
            }
         }
      } while (x < 45);// 102

      return 1;// 104
   }

   public int test5(int x) {
      do {
         try {
            if (x < 25) {// 114
               int var2 = 5;// 115
               byte var3;
               return var2 + var3;// 128
            }
         } finally {
            if (x > 3) {// 120
               return 1;// 126
            }
         }
      } while (x < 45);// 124

      return 1;
   }

   public void emptyInnerFinally() {
      int a = 0;// 133
      int b = 1;
      int c = 2;

      try {
         while (true) {
            try {
               System.out.println("Hello");// 137
               return;// 138
            } catch (Exception var13) {// 139
            } finally {
               ;
            }
         }
      } finally {
         System.out.println("hi");// 144
      }
   }

   // $VF: Could not inline inconsistent finally blocks
   public void testConditionalBreakInFinally() throws Throwable {
      for (int a = 5; a != 886; a += 616) {// 149 152 166
         label60: {
            label59: {
               try {
                  try {
                     a -= 885;// 157
                     break label59;
                  } catch (Exception var17) {// 158
                     System.out.println("hello");// 159
                  }
               } catch (Throwable var7) {
                  if (a < -228) {
                     throw var7;// 164
                  }
                  break label60;
               }

               if (a < -228) {// 161
                  continue;
               }
               break label60;
            }

            if (a < -228) {
               continue;
            }
         }

         System.out.println("hi");// 169
         return;// 171
      }
   }// 153

   public void loopInFinally() {
      boolean var1 = true;// 174

      try {
         try {
            System.out.println(var1);// 178
         } finally {
            return;// 180
         }
      } finally {
         short var18 = 15080;// 183

         while (var18 > -14704) {// 184
            boolean var9 = false;// 185
         }
      }
   }

   public void test6(Object o) {
      while (true) {
         try {
            System.out.println("try");// 193
         } finally {
            label41:
            if (o != null) {// 195
               try {
                  System.out.println("finally");// 197
               } catch (Exception var8) {// 199
                  break label41;
               }

               return;// 203
            }
         }
      }
   }

   public void test7(Object o) {
      while (true) {
         try {
            System.out.println("try");// 208
         } finally {
            label41:
            if (o != null) {// 210
               try {
                  System.out.println("finally");// 212
               } catch (Exception var8) {// 214
                  break label41;
               }

               System.out.println("outer");// 219
               return;// 220
            }
         }
      }
   }

   public void test8(Object o) {
      while (true) {
         try {
            System.out.println("try");// 225
         } finally {
            if (o != null) {// 227
               try {
                  System.out.println("finally");// 229
                  continue;
               } catch (Exception var8) {// 231
               }
            }
         }
      }
   }

   public void test9(Object o) {
      while (true) {
         try {
            System.out.println("try");// 240
         } finally {
            label41:
            if (o != null) {// 242
               try {
                  System.out.println("finally");// 244
               } catch (Exception var8) {// 246
                  System.out.println("outer finally");// 248
                  break label41;
               }

               return;// 252
            }
         }
      }
   }
}

